{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "horus-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3005
    },
    {
      "name": "horus-intel",
      "runtimeExecutable": "node",
      "runtimeArgs": ["intel/server.js"],
      "port": 4000
    },
    {
      "name": "horus-standalone",
      "runtimeExecutable": "node",
      "runtimeArgs": ["desktop/.staging/server/server.js"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
