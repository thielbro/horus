# ─── HORUS — Environment Variables ───
# Copy this file to .env.local and fill in values as needed.
# The platform works without most keys — data sources with missing keys are gracefully skipped.

# ── AI Intelligence Layer (Gemini) ──
# Get free API keys at https://aistudio.google.com/apikey
# Multiple keys enable round-robin rotation to maximize free-tier rate limits.
# At minimum, set GEMINI_API_KEY_1. Add up to 8 for high-traffic deployments.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=
# GEMINI_API_KEY_6=
# GEMINI_API_KEY_7=
# GEMINI_API_KEY_8=

# ── Data Source API Keys (optional) ──
# FIRMS_API_KEY=                        # NASA FIRMS fire data (https://firms.modaps.eosdis.nasa.gov/api/area/)
# AIS_API_KEY=                          # Maritime vessel tracking (aisstream.io)
# OPENSKY_CLIENT_ID=                    # OpenSky OAuth2 — higher rate limits
# OPENSKY_CLIENT_SECRET=                # OpenSky OAuth2

# ── Victoria (VicRoads) traffic cameras (optional) ──
# Free token: email traffic_requests@vicroads.vic.gov.au (subject "API Token Request").
# Without it, the VIC camera source is silently skipped.
# VICROADS_API_TOKEN=
# VICROADS_WFS_URL=https://api.vicroads.vic.gov.au/vicroads/wfs   # override if needed
# VICROADS_CAMERA_TYPENAME=vicroads:traffic_camera               # adjust to the real WFS layer name once verified

# ── Scanner Backend (required for RECON features) ──
# Bundled service in docker-compose (./scanner). Set SCANNER_KEY to any secret;
# the scanner container reads it as HORUS_KEY. Locally (no Docker), run
# `cd scanner && HORUS_KEY=secret npm start` and use SCANNER_URL=http://localhost:7700.
# SCANNER_URL=http://scanner:7700       # Horus scanner backend URL (compose service name)
# SCANNER_KEY=                          # Shared secret — must match the scanner's HORUS_KEY

# ── Fixed Surveillance Feed Backend (optional) ──
# Replaces direct Overpass for the four counter-surveillance buttons only:
# OSM surveillance cameras, Flock/ALPR, police stations, and mass-surveillance tech.
# Docker Compose supplies http://surveillance-feed:7800 by default.
# SURVEILLANCE_FEED_URL=http://127.0.0.1:7800
# SURVEILLANCE_FEED_ADMIN_TOKEN=         # Bearer token for imports/refresh jobs
# SURVEILLANCE_FEED_TILE_DEGREES=0.25    # Coarse OSM refresh cache tile size
# SURVEILLANCE_FEED_WORKERS=2            # Concurrent sidecar refresh workers
# SURVEILLANCE_FEED_RETRY_BASE_MS=300000 # Failed refresh retry backoff base
