# ═══════════════════════════════════════════════════════════════════════════
#  HORUS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  HORUS works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  The application reads SCANNER_URL / SCANNER_KEY for the RECON backend and
#  the optional INTELLIGENCE SECTOR values below when Docker Compose starts the
#  horus-intel service. The remaining data-source keys are optional and only
#  needed for higher rate limits / future data sources.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND  ── the ONLY keys the current code consumes ──
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate HORUS scanner backend.
#  SCANNER_KEY here MUST equal the backend's HORUS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=

# ─────────────────────────────────────────────────────────────────────────
#  FIXED SURVEILLANCE FEED BACKEND
#  Public reads do not need a secret. Admin imports/refreshes require the
#  sidecar's SURVEILLANCE_FEED_ADMIN_TOKEN. Docker Compose points the app at
#  http://surveillance-feed:7800 by default.
# ─────────────────────────────────────────────────────────────────────────
SURVEILLANCE_FEED_URL=
SURVEILLANCE_FEED_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
#  ACTIVATION-GATED LIVE FEED BACKEND
#  Public reads and activity signals do not need a secret. Docker Compose
#  points the app at http://live-feed:7900 by default. Maritime AIS positions
#  are memory-only and sampled only while the layer is active.
# ─────────────────────────────────────────────────────────────────────────
LIVE_FEED_URL=
LIVE_FEED_MARITIME_RECONNECT_MS=5000
LIVE_FEED_MARITIME_MAX_RESPONSE=5000
LIVE_FEED_LEASE_TTL_MS=150000


# ─────────────────────────────────────────────────────────────────────────
#  INTELLIGENCE SECTOR  (optional self-hosted entity graph sources)
# ─────────────────────────────────────────────────────────────────────────
# OSINT_CACHE_URL routes intel lookups through the local horus-cache Nginx
# allowlist. Leave this default in Docker; leave empty for direct dev lookups.
OSINT_CACHE_URL=http://horus-cache:8080/proxy/osint

# Yente/OpenSanctions is opt-in because it also starts an Elasticsearch index that
# can consume 4-16GB RAM and 10-30GB+ disk while indexing. Enable it with:
#   docker compose --profile intel-full up -d
# The intel service falls back to the lightweight OFAC CSV index if Yente is not
# running or not yet healthy.
YENTE_URL=http://yente:8000
YENTE_DATASET=default
YENTE_LIMIT=5
YENTE_MANIFEST=/app/manifests/civic.yml
OPENSANCTIONS_DELIVERY_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  ANALYTICS  (optional, opt-in)
# ─────────────────────────────────────────────────────────────────────────
# Umami page-view analytics. It is OFF unless UMAMI_ENDPOINT is set — so the dev
# server and the packaged desktop app never call it (they leave it unset). Set it
# to your umami instance's /api/send URL to enable it. In Docker, use a URL
# reachable from the horus container, for example a host-published Umami URL.
#   e.g. UMAMI_ENDPOINT=http://host.docker.internal:3001/api/send
UMAMI_ENDPOINT=
# Optional — umami website id to report under (a default is baked into the code).
# UMAMI_WEBSITE_ID=


# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
HORUS_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# HORUS_TELEGRAM_CHANNELS=

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0
