{
  "name": "osiris-native-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "OSIRIS — Open Source Intelligence & Reconnaissance Integrated System",
  "author": "OSIRIS",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-watchdog.ps1",
    "dev:raw": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop": "electron .",
    "desktop:smoke": "cross-env OSIRIS_SMOKE=1 electron .",
    "desktop:dev": "concurrently -k -n NEXT,ELECTRON -c green,cyan \"npm run dev\" \"wait-on http://localhost:3000 && cross-env OSIRIS_DEV=1 electron .\"",
    "desktop:prepare": "node desktop/prepare-standalone.js",
    "desktop:build": "next build && npm run desktop:prepare && electron-builder --win"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "google-libphonenumber": "^3.2.44",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-map-gl": "^8.1.1",
    "rss-parser": "^3.13.0",
    "satellite.js": "^7.0.0",
    "sharp": "^0.34.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
