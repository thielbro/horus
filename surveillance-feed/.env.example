# HORUS surveillance-feed sidecar
# Copy to `.env` when running this service directly with `npm start`.
# Docker Compose can use the same names from the repo-level `.env`.

# HTTP bind address and port for the sidecar.
# Use 127.0.0.1 behind Nginx/Caddy; use 0.0.0.0 only when exposing directly.
SURVEILLANCE_FEED_BIND=127.0.0.1
SURVEILLANCE_FEED_PORT=7800

# SQLite database path. Relative paths resolve from the working directory.
SURVEILLANCE_FEED_DB=./data/surveillance-feed.sqlite

# Bearer token required for /v1/admin/import, /v1/admin/refresh, and /v1/admin/jobs.
# Generate one with: openssl rand -hex 32
SURVEILLANCE_FEED_ADMIN_TOKEN=

# Default refresh cadence for fixed OSM-derived records. 604800000 = 7 days.
SURVEILLANCE_FEED_REFRESH_MS=604800000

# Refresh cache tile size in degrees. Nearby viewport pans share one queued job.
SURVEILLANCE_FEED_TILE_DEGREES=0.25

# Number of queued refresh jobs to process concurrently.
SURVEILLANCE_FEED_WORKERS=2

# Retry backoff base for failed refresh jobs. Retries use exponential backoff.
SURVEILLANCE_FEED_RETRY_BASE_MS=300000

# Failed refresh jobs are retried this many total attempts before status=failed.
SURVEILLANCE_FEED_MAX_JOB_ATTEMPTS=3

# Maximum public read/refresh bbox size in square degrees.
SURVEILLANCE_FEED_MAX_BBOX_AREA=25

# Maximum records returned per /v1/layers request.
SURVEILLANCE_FEED_MAX_ROWS=5000

# Per-Overpass refresh attempt timeout in milliseconds.
SURVEILLANCE_FEED_OVERPASS_TIMEOUT_MS=45000

# Comma-separated Overpass API endpoints used by queued refresh jobs.
SURVEILLANCE_FEED_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
